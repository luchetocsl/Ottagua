---
//
---

<section class='bg-cream min-h-[70vh] flex items-center'>
	<main
		class='w-full max-w-[1240px] mx-auto px-4 flex justify-center items-center'>
		<div class='flex flex-col gap-4 items-center w-2/3 text-red'>
			<h1
				class='text-5xl font-bold leading-tight text-center md:text-6xl lg:text-7xl'>
				Aventuras de una familia mexicana en Ottawa
			</h1>
			<div class='flex flex-col gap-8 items-center w-full'>
				<p class='max-w-md text-lg text-center'>
					Historias reales, descubrimientos y tips para vivir,
					disfrutar y adaptarse a la capital de Canadá.
				</p>
				<form
					class='flex flex-col gap-1 w-full max-w-sm'
					id='hero-form'>
					<div class='flex flex-col gap-1 md:flex-row'>
						<input
							type='email'
							name='email'
							placeholder='tu@email.com'
							required
							class='flex-1 px-3 py-1.5 text-xs rounded-full border transition-colors outline-none border-red text-red focus:border-red-accent'
						/>
						<button
							type='submit'
							class='inline-flex gap-1 justify-center items-center px-4 py-1.5 text-xs rounded-full transition-all cursor-pointer bg-red text-cream hover:bg-red-accent'>
							Suscríbete <i class='ri-arrow-right-up-line'></i>
						</button>
					</div>
					<div id='hero-form-message' class='h-4 text-xs'></div>
				</form>
			</div>
		</div>
	</main>
</section>

<!-- All styling now handled by Tailwind classes -->

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const form = document.getElementById("hero-form") as HTMLFormElement;
		const messageDiv = document.getElementById("hero-form-message");

		if (!form || !messageDiv) return;

		form.addEventListener("submit", async (e) => {
			e.preventDefault();

			const formData = new FormData(form);
			const emailValue = formData.get("email");
			if (!emailValue) {
				messageDiv.textContent =
					"Error: El correo electrónico es requerido";
				messageDiv.style.color = "var(--red-accent)";
				return;
			}

			const email = emailValue.toString();
			const nameValue = formData.get("name");
			const name = nameValue ? nameValue.toString() : "";

			try {
				const response = await fetch("/api/subscribe", {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
					},
					body: JSON.stringify({ email, name }),
				});

				if (response.ok) {
					// Success
					messageDiv.textContent = "¡Gracias por suscribirte!";
					messageDiv.style.color = "var(--red)";
					form.reset();

					// Redirect to the gracias page
					window.location.href = "/gracias";
				} else {
					const contentType =
						response.headers.get("content-type") || "";
					const errorData = contentType.includes("application/json")
						? await response.json()
						: { message: await response.text() };
					console.error("Submission error:", {
						status: response.status,
						body: errorData,
					});

					messageDiv.textContent = `Error: ${errorData.message || "Hubo un problema al procesar tu solicitud"}`;
					messageDiv.style.color = "var(--red-accent)";
				}
			} catch (error) {
				// Handle network errors
				messageDiv.textContent =
					"Error de conexión. Por favor, intenta de nuevo más tarde.";
				messageDiv.style.color = "var(--red-accent)";
				console.error("Submission error:", error);
			}
		});
	});
</script>
