<section class='bg-cream min-h-[70vh] flex items-center'>
	<main
		class='w-full max-w-[1240px] mx-auto px-4 flex justify-center items-center'>
		<div class='flex flex-col gap-4 items-center w-2/3 text-red'>
			<h1
				class='text-5xl font-bold leading-tight text-center md:text-6xl lg:text-7xl'>
				Aventuras de una familia mexicana en Ottawa
			</h1>
			<div class='flex flex-col gap-8 items-center w-full'>
				<p class='max-w-md text-lg text-center'>
					Historias reales, descubrimientos y tips para vivir,
					disfrutar y adaptarse a la capital de Canadá.
				</p>
				<a
					href='#signup'
					class='inline-flex gap-1 justify-center items-center px-4 py-1.5 text-xs rounded-full transition-all cursor-pointer bg-red text-cream hover:bg-red-accent'>
					Suscríbete <i class='ri-arrow-right-up-line'></i>
				</a>
			</div>
		</div>
	</main>
</section>
